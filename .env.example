# LLM API
OPENAI_API_KEY="sk-your-api-key"
OPENAI_API_BASE="http://your-api-base"
OPENAI_MODEL="model-name"

# Google OAuth (Gmail + Google Calendar)
GOOGLE_CLIENT_ID="your-client-id"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:8000/auth/callback"

# App settings
SECRET_KEY="change-me"
BACKEND_PORT=8000
MAX_TOKEN=5120
DRY_RUN=true
DEMO_MODE=true
DEMO_REFERENCE_TIME=""

# Assistant runtime
AGENT_ENABLED=true
AGENT_MODE="semi_auto"
AGENT_SHADOW_MODE=false
AGENT_MAX_STEPS=8
AGENT_MIN_CONFIDENCE=0.75
AGENT_AUTO_WRITE_RISK_LIMIT="external_write"

# Automation
BACKGROUND_REFRESH_INTERVAL_MINUTES=10
AUTO_LABEL_ENABLED_DEFAULT=false
AUTO_LABEL_LOOKBACK_DAYS=7
AUTO_LABEL_MAX_PER_CYCLE=20
AUTO_LABEL_REQUEST_INTERVAL_SECONDS=5
